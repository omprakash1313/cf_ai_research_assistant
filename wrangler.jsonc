{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-research-assistant",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI (Llama 3.3). There is no local model runtime, so dev calls
  // the real service and needs `wrangler login`.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ResearchAgent",
        "name": "ResearchAgent"
      }
    ]
  },
  "workflows": [
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["ResearchAgent"],
      "tag": "v1"
    }
  ],
  "observability": { "enabled": true }
}
